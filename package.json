{
  "name": "astro-ts-tw-hello",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "unset:git-hooks-path": "git config --unset core.hooksPath",
    "simple-git-hooks": "npx simple-git-hooks",
    "postinstall": "is-ci || npm run simple-git-hooks",
    "prettier": "npx prettier --write  \"**/*.{js,jsx,ts,tsx,md,mdx,astro}\"",
    "eslint": "npx eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "lint": "run-s prettier eslint",
    "tsc": "npx tsc --noEmit",
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "sync": "astro sync",
    "astro": "astro",
    "gh-pages-build": "cross-env GITHUB_PAGES=true pnpm build",
    "gh-pages-preview": "cross-env GITHUB_PAGES=true GITHUB_PAGES_PREVIEW=true pnpm preview"
  },
  "dependencies": {
    "astro": "7.3.5",
    "canvas-confetti": "1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/ts-plugin": "1.10.12",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.2",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "autoprefixer": "10.6.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "is-ci": "4.1.0",
    "lint-staged": "17.5.1",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "2.14.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,md,mdx,astro}": "prettier --write",
    "src/**/*.{js,ts,jsx,tsx,astro}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "github_pages": "https://erkobridee.github.io"
}
